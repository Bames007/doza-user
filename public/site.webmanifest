{
  "name": "Doza: Your Personal Medic Assistant",
  "short_name": "Doza",
  "description": "The unified healthcare ecosystem. Access your medical records, book appointments, and track medications.",
  "start_url": "/dashboard",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "minimal-ui"
  ],
  "background_color": "#ffffff",
  "theme_color": "#065f46",
  "id": "com.dozamedic.dashboard",
  "dir": "ltr",
  "orientation": "portrait-primary",
  "categories": [
    "health",
    "medical",
    "lifestyle"
  ],
  "lang": "en-US",
  "scope": "/",
  "icons": [
    {
      "src": "/logo.png",
      "sizes": "500x500",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable/maskable_icon_x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/maskable/maskable_icon_x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/maskable/maskable_icon_x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/maskable/maskable_icon_x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/maskable/maskable_icon_x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/maskable/maskable_icon_x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/maskable/maskable_icon_x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/maskable/maskable_icon.png",
      "sizes": "783x783",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Book Appointment",
      "short_name": "Book",
      "url": "/dashboard/appointments/new",
      "icons": [
        {
          "src": "/maskable/maskable_icon_x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Medical Records",
      "short_name": "Records",
      "url": "/dashboard/records",
      "icons": [
        {
          "src": "/maskable/maskable_icon_x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/og-image.png",
      "sizes": "1280x720",
      "type": "image/png",
      "platform": "wide",
      "label": "Doza Healthcare Dashboard Overview"
    },
    {
      "src": "/og-image.png",
      "sizes": "1280x720",
      "type": "image/png",
      "platform": "narrow",
      "label": "Doza Mobile Experience"
    }
  ]
}